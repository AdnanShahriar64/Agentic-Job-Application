-% Resume_template.tex — ATS-conscious, single-column LaTeX template
-% Compile: pdflatex -interaction=nonstopmode -halt-on-error Resume_template.tex
-% Optional: create resume_content.tex in the same folder to supply job-specific text.
-% FIXED CONTENT: contact header, education, employers/titles/locations/dates.
-% DYNAMIC CONTENT: summary, skills, experience bullets, optional additional work,
-% demonstrations. Never rewrite fixed content when tailoring.
-\documentclass[10pt,letterpaper]{article}
-\usepackage[T1]{fontenc}
-\usepackage[utf8]{inputenc}
-\usepackage{lmodern}
-\usepackage[margin=0.70in,top=0.62in,bottom=0.65in]{geometry}
-\usepackage[unicode,hidelinks,breaklinks]{hyperref}
-\usepackage{xurl}
-\usepackage{enumitem}
-\usepackage{titlesec}
-\usepackage{microtype}
-\usepackage{etoolbox}
-\urlstyle{same}
-\pagestyle{empty}
-\setlength{\parindent}{0pt}
-\setlength{\parskip}{2pt}
-\setlist[itemize]{leftmargin=1.2em,itemsep=1.5pt,topsep=2pt,parsep=0pt,partopsep=0pt}
-\titleformat{\section}{\normalsize\bfseries}{}{0pt}{}[\titlerule]
-\titlespacing*{\section}{0pt}{9pt}{4pt}
-\newcommand{\job}[3]{\textbf{#1} --- #2\hfill\textit{#3}\par}
-\newcommand{\subjob}[1]{\textit{#1}\par}
-% Content macros: safe fallback is an empty section or explanatory placeholder.
-\newcommand{\ResumeSummary}{\textit{[Insert job-specific professional summary.]}}
