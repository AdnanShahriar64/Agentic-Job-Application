-            for message in report['warnings']:
-                print('WARNING:', message)
-            if not report['passed']:
-                return 2
-        return 0
-    except (ValueError, OSError, RuntimeError, subprocess.TimeoutExpired, json.JSONDecodeError) as exc:
-        print('ERROR:', exc, file=sys.stderr)
-        return 1
